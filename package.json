{
  "name": "okorion-io-src",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:model-points": "node scripts/generate-model-points.mjs",
    "prebuild": "npm run generate:model-points",
    "build": "tsc -b && vite build",
    "postbuild": "npm run test:portfolio",
    "typecheck": "tsc -b --pretty false",
    "check:career-catalog": "node scripts/sync-career-exclusion-catalog.mjs --check",
    "sync:career-catalog": "node scripts/sync-career-exclusion-catalog.mjs",
    "test:portfolio": "npm run check:career-catalog && node scripts/validate-portfolio-content.mjs && node scripts/validate-portfolio-exclusion-regression.mjs && node scripts/validate-portfolio-exclusion-platform.mjs",
    "lint": "biome check .",
    "format": "biome check . --write",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "use-error-boundary": "^2.0.6",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@biomejs/biome": "2.5.13",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "~7.0.2"
  }
}
